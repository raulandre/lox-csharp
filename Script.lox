var a = "global";
{
    fun showA() {
        print a;
    }

    showA();
    var a = "block";
    showA();
}

fun makeCounter() {
    var i = 0; 
    fun counter() { 
        print i; 
        i = i + 1; 
    } 
    return counter; 
} 

var counter = makeCounter(); 
for(var i = 0; i < 3; i = i + 1)
    counter();