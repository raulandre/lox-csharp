fun greet(name)
{
    return "Hello " + name;
}

fun excite(level, greeting)
{
    if(level <= 0)
        return greeting;
    if(level > 120)
        return "No one is this old!";
    
    return excite(level - 1, greeting + "!");
}

print "Enter your name: ";
var greeting = read() |> greet;
print "Enter your age: ";
print read() |> number |> excite(greeting);

class Foo {
    init(x, y)
    {
        this.x = x;
        this.y = y;
    }

    bar() {
        return this.x + this.y;
    }
}

print "Enter a number: ";
print "Successor is: " + (read() |> number |> Foo(1)).bar();